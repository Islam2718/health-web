# Centralized API base URL — every API call in the app is built from this
# single value (see src/lib/api-client.ts). Change it here to repoint the
# whole app at a different backend (staging, new domain, etc.).
NEXT_PUBLIC_API_BASE_URL=https://health-api.phicsart.com/api

# Public site base URL — used for absolute links/metadata if needed.
NEXT_PUBLIC_APP_URL=https://health.phicsart.com

# Google OAuth Client ID (from Google Cloud Console > APIs & Services >
# Credentials > OAuth 2.0 Client IDs, type "Web application"). Its
# "Authorized JavaScript origins" must list every origin the app is served
# from (e.g. http://localhost:3000 and https://health.phicsart.com) — the
# Google Identity Services script used for "Sign in with Google" checks this
# client-side, no redirect URI needed since we use the token-client flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
